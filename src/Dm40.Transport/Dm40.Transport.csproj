<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>Dm40.Transport</AssemblyName>
    <RootNamespace>Dm40.Transport</RootNamespace>
    <!--
      BLE 传输层：使用 WinRT Windows.Devices.Bluetooth。
      经 Microsoft.Windows.SDK.Contracts NuGet 包获得 WinRT .NET 投影，无需安装完整 Windows SDK。
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 微软官方 WinRT .NET 投影（含 Windows.Devices.Bluetooth 等 API，并传递引用 System.Runtime.WindowsRuntime 互操作程序集） -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dm40.Core\Dm40.Core.csproj" />
    <ProjectReference Include="..\Dm40.Protocol\Dm40.Protocol.csproj" />
  </ItemGroup>

</Project>
